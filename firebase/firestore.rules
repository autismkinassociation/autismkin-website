rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Staff who can open autismkin.com/#admin. The email must be confirmed.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['peter.rodriguez@autismkin.com'];
    }

    // Each parent can read and write only their own profile and progress.
    // Admins can read profiles to build the combined numbers on the dashboard.
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // Anonymous usage counters: stats/{all or YYYY-MM}/c/{counter} = { n: number }.
    // Anyone may add exactly 1 to a counter; only admins may read them.
    match /stats/{period}/c/{counter} {
      function okName() {
        return (period == 'all' || period.matches('^20[0-9]{2}-[01][0-9]$'))
          && counter.matches('^[a-z0-9_]{1,60}$')
          && request.resource.data.keys().hasOnly(['n']);
      }
      allow read: if isAdmin();
      allow create: if okName() && request.resource.data.n == 1;
      allow update: if okName() && request.resource.data.n == resource.data.n + 1;
      allow delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
